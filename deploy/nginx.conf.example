# Example nginx config for Charité / local Docker Compose.
# Production (westhafen) typically listens on 443 with TLS; keep the same ^~ location
# order so GeneBe/Ensembl/VariantValidator are not swallowed by /spliceai-lookup/.

events {
    worker_connections 1024;
}

http {
    include mime.types;

    upstream spliceai_frontend {
        server modified-spliceai-lookup:8080;
    }

    upstream spliceai_37_api {
        server spliceai-37-api:8080;
    }

    upstream spliceai_38_api {
        server spliceai-38-api:8080;
    }

    # HTTP → HTTPS redirect (enable on production hosts that terminate TLS here)
    # server {
    #     listen 80;
    #     server_name westhafen.charite.de;
    #     return 301 https://$host$request_uri;
    # }

    server {
        listen 80;
        # Production: listen 443 ssl; and set ssl_certificate / ssl_certificate_key
        server_name _;

        # Order matters: ^~ API and external proxies MUST come before /spliceai-lookup/

        location ^~ /spliceai-lookup/api/38/ {
            proxy_pass http://spliceai_38_api/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 600s;
            proxy_send_timeout 600s;
            proxy_read_timeout 600s;
            send_timeout 600s;
        }

        location ^~ /spliceai-lookup/api/37/ {
            proxy_pass http://spliceai_37_api/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 600s;
            proxy_send_timeout 600s;
            proxy_read_timeout 600s;
            send_timeout 600s;
        }

        # Same-origin paths for GeneBe / Ensembl / VariantValidator.
        # Do NOT proxy_pass these to the public HTTPS hosts from nginx: Charité egress
        # often blocks that (instant 502), and nginx ignores HTTP(S)_PROXY.
        # Forward to the Flask app instead; server.py proxies outbound (honours HTTPS_PROXY).
        # These ^~ blocks are optional if /spliceai-lookup/ already maps to the frontend —
        # they only ensure the paths are not accidentally routed elsewhere.
        location ^~ /spliceai-lookup/genebe/ {
            proxy_pass http://spliceai_frontend/genebe/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 30s;
            proxy_read_timeout 30s;
        }

        location ^~ /spliceai-lookup/ensembl-grch37/ {
            proxy_pass http://spliceai_frontend/ensembl-grch37/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 90s;
            proxy_read_timeout 90s;
        }

        location ^~ /spliceai-lookup/ensembl/ {
            proxy_pass http://spliceai_frontend/ensembl/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 90s;
            proxy_read_timeout 90s;
        }

        location ^~ /spliceai-lookup/variantvalidator/ {
            proxy_pass http://spliceai_frontend/variantvalidator/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 30s;
            proxy_read_timeout 30s;
        }

        location /spliceai-lookup/ {
            proxy_pass http://spliceai_frontend/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location = /spliceai-lookup {
            return 301 /spliceai-lookup/;
        }

        location / {
            return 200 'Nginx is running';
            add_header Content-Type text/plain;
        }
    }
}
