events {
    worker_connections 1024;
}

http {
    upstream spliceai_frontend {
        server modified-spliceai-lookup:8080;
    }

    upstream spliceai_37_api {
        server spliceai-37-api:8080;
    }

    upstream spliceai_38_api {
        server spliceai-38-api:8080;
    }

    server {
        listen 80;
        server_name _;

        # Frontend (static UI + Flask shim)
        location /spliceai-lookup/ {
            proxy_pass http://spliceai_frontend/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location = /spliceai-lookup {
            return 301 /spliceai-lookup/;
        }

        # Local SpliceAI API proxies (paths must match index.html baseApiUrl)
        location /spliceai-lookup/api/37/ {
            proxy_pass http://spliceai_37_api/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_read_timeout 900s;
        }

        location /spliceai-lookup/api/38/ {
            proxy_pass http://spliceai_38_api/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_read_timeout 900s;
        }

        # Optional: serve the app at the site root
        location / {
            proxy_pass http://spliceai_frontend/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }
    }
}
