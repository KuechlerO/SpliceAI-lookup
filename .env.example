# Copy to .env next to docker-compose.yml and adjust values.
# Used by docker compose for variable substitution (${VAR} syntax).

# PostgreSQL password (must match POSTGRES_PASSWORD and DB_PASSWORD on API services)
SPLICEAI_DB_PASSWORD=change-me

# Optional HTTP(S) proxy for image builds and outbound requests from the frontend container
# HTTPS_PROXY=http://proxy.example.org:8080
# HTTP_PROXY=http://proxy.example.org:8080

# Hostnames that must bypass the proxy (comma-separated, no spaces)
# NO_PROXY=localhost,127.0.0.1,redis-cache,postgres,spliceai-37-api,spliceai-38-api
